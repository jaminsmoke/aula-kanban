# Ejemplo en revisión: Caddy interno de Nodum para el vps-manager.
# Adaptado de github.com/nodummd/nodum/deploy/caddy/Caddyfile.
# Copiar como ./caddy/Caddyfile en el stack (montado en solo lectura).
#
# Diferencias respecto al oficial, intencionadas:
# - Sin `X-Frame-Options: DENY`: Aula Kanban embebe Nodum en un iframe de
#   Mi espacio. El proxy exterior del VPS además no pasa cabeceras X-Frame*.
# - `{$NODUM_SITE_ADDRESS::80}` queda en `:80` (HTTP plano): el TLS lo
#   termina el Caddy exterior del VPS, que redirige a 127.0.0.1:${NODUM_HTTP_PORT}.

{
  admin off
  log {
    format json
  }
}

{$NODUM_SITE_ADDRESS::80} {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }

  handle /api/* {
    reverse_proxy nodum_api:8000
  }

  handle_path /s3/* {
    reverse_proxy nodum_minio:9000 {
      header_up Host nodum_minio:9000
    }
  }

  handle {
    reverse_proxy nodum_web:3000
  }
}
