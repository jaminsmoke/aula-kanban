# Plantilla cerrada por defecto. No sustituir el Caddyfile del servidor ni
# modificar las reglas de otros servicios al instalar Aula Kanban.
#
# Los servicios de Aula deben escuchar solo en loopback o en redes privadas.
# Estas respuestas NO implementan el acceso autenticado: la pasarela descrita
# en SECURE-ACCESS.md debe implementarse y verificarse antes de abrir rutas.

{$AULA_AGENT_DOMAIN} {
  respond 403
}

{$AFFINE_DOMAIN} {
  respond 403
}

{$NODUM_DOMAIN} {
  respond 403
}
